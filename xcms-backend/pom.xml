<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.df4j.xctec.xcms</groupId>
    <artifactId>xcms</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>XCMS Parent</name>
    <description>XCMS - 集团中台技术底座</description>

    <modules>
        <module>xcms-shared-kernel</module>
        <module>xcms-tenant-management</module>
        <module>xcms-organization</module>
        <module>xcms-identity</module>
        <module>xcms-authorization</module>
        <module>xcms-workflow</module>
        <module>xcms-message</module>
        <module>xcms-configuration</module>
        <module>xcms-file-storage</module>
        <module>xcms-task-scheduling</module>
        <module>xcms-audit</module>
        <module>xcms-portal</module>
        <module>xcms-operation</module>
        <module>xcms-app</module>
    </modules>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 自定义依赖版本（Spring Boot BOM 不管理的） -->
        <!-- 注意：不能用 querydsl.version，会覆盖 Spring Boot 管理的原版 querydsl 属性 -->
        <querydsl-feign.version>7.5</querydsl-feign.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <flowable.version>7.0.1</flowable.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <flatten-plugin.version>1.6.0</flatten-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM 已通过 parent 继承，不需要手动导入 -->

            <!-- XCMS 内部模块 -->
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-shared-kernel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-tenant-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-tenant-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-org-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-org-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-identity-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-identity-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-auth-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-auth-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-workflow-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-workflow-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-message-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-message-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-config-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-config-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-file-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-file-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-task-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-task-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-audit-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-audit-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-portal</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec.xcms</groupId>
                <artifactId>xcms-operation</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- QueryDSL (OpenFeign fork, v7.x) -->
            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <version>${querydsl-feign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-apt</artifactId>
                <version>${querydsl-feign.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Lombok MapStruct Binding（Lombok 本身由 Spring Boot 管理） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>

            <!-- Flowable -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter</artifactId>
                <version>${flowable.version}</version>
            </dependency>

            <!-- JJWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- springdoc-openapi -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- maven-compiler-plugin: source/target 继承自 starter-parent，只覆盖 annotation processors -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <!-- QueryDSL APT 在 impl 模块中单独配置 -->
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- flatten-maven-plugin: CI-friendly 版本管理 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- spring-boot-maven-plugin: 继承自 starter-parent，不需要配 version -->
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>sonatype-snapshots</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

</project>
