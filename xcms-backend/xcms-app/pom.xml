<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.df4j.xctec.xcms</groupId>
        <artifactId>xcms</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>xcms-app</artifactId>
    <name>XCMS Application</name>
    <dependencies>
        <!-- All impl modules -->
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-tenant-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-org-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-identity-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-auth-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-workflow-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-message-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-config-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-file-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-task-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-audit-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-portal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec.xcms</groupId>
            <artifactId>xcms-operation</artifactId>
        </dependency>

        <!-- Runtime dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-persistence</artifactId>
        </dependency>
        <!-- Web 服务（portal/operation 已传递引入，此处显式声明以明确应用形态） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 缓存抽象（authorization 模块据此定义 CaffeineCacheManager） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- springdoc-openapi 暂时移除：2.6.0 与 Spring Boot 4（Spring Data 4.0 移除
             org.springframework.data.util.TypeInformation）不兼容，启动期
             QuerydslPredicateOperationCustomizer 报 NoClassDefFoundError。
             待 springdoc 适配 Boot 4 后恢复（backend 未使用 @Operation 等注解，移除无编译影响）。 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- H2 for development (profile: h2) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MySQL driver (profile: mysql) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
